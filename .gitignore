# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code 로컬 워크트리(중첩 git 저장소)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# assets folder (엑셀 원본 파일)
# 디렉터리 자체는 추적 가능하게 두고 안의 내용물만 차단 — 그래야 exam_kit/ 만 예외 처리 가능.
/assets/**
# cc:essay CLI 가 읽는 템플릿/스타일은 git 추적.
!/assets/exam_kit/
!/assets/exam_kit/**
*.xlsx
*.xls
~$*.xlsx
~$*.xls

# uploads (기출문제 등)
/uploads

# mcp-bridge (별도 패키지)
/mcp-bridge/node_modules
/mcp-bridge/dist

# logs
*.log
watch.log

# 서술형 초안 (Claude Code 로컬 JSON)
.essay-drafts/
.essay-audit-logs/
.variant-drafts/

# 주제 자체모델 (Mac MLX / Windows CUDA) — 데이터·어댑터·venv 는 로컬만
/data/topic-finetune/
/data/topic-explain-finetune/
/data/topic-pipeline-failures/
/ml/topic/.venv/
/ml/topic/windows/.venv/
/ml/topic/adapters/
/ml/topic/__pycache__/

# 제목·주장 자체모델 (주제 파이프라인 복제, Windows CUDA) — 데이터·어댑터·venv 는 로컬만
/data/title-finetune/
/data/title-explain-finetune/
/data/title-pipeline-failures/
/ml/title/.venv/
/ml/title/windows/.venv/
/ml/title/adapters/
/ml/title/__pycache__/
/data/claim-finetune/
/data/claim-explain-finetune/
/data/claim-pipeline-failures/
/ml/claim/.venv/
/ml/claim/windows/.venv/
/ml/claim/adapters/
/ml/claim/__pycache__/
# 로컬 LoRA 워커 — PC 당 하나만 뜨게 잡는 잠금 파일, 창 없이 돌 때의 로그
/ml/worker/.worker.lock
/ml/worker/logs/
/ml/topic/windows/__pycache__/
/ml/topic/**/checkpoints/
.essay-audit-reports/
.grammar-drafts/
.syntax-drafts/
.essay-step-drafts/
.block-workbook-drafts/
.narrative-drafts/
.bv-drafts/

# Audit 작업 중 자동 생성되는 일회성 패치 스크립트
scripts/patch-essay-*.ts
scripts/patch-mv-*.ts

# 공유자료 — 자료 파일은 배포 환경에서 직접 업로드 (git 추적 X)
# 단, meta.json 과 .gitkeep 은 코드와 함께 관리해도 OK
/public/shared-resources/**
!/public/shared-resources/.gitkeep
!/public/shared-resources/*/meta.json

# 일회성 임시 스크립트
scripts/tmp-*.ts

# 런타임 패치 백업
scripts/.backups/
